<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_form_line_report_parameters" model="ir.ui.view">
        <field name="name">mrp.production.form.line.report.parameters</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="custom_novici.view_mrp_production_form_register_rollos"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Parámetros de operación" name="line_report_parameters">
                    <div class="alert alert-info" role="alert">
                        Los parámetros se solicitan por cada línea al iniciar el turno.
                        Este bloque conserva los valores de la línea principal para
                        compatibilidad con el tablero y el reporte PDF; las capturas de
                        todas las líneas quedan en el historial.
                    </div>
                    <field name="line_report_workcenter_ids"
                           widget="many2many_tags"
                           readonly="1"
                           options="{'no_create': True, 'no_open': True}"/>
                    <field name="line_report_parameters_registered" invisible="1"/>
                    <group>
                        <group>
                            <field name="line_report_target_grammage"/>
                            <field name="line_report_suction"/>
                            <field name="line_report_range_hood"/>
                            <field name="line_report_winder_speed"/>
                            <field name="line_report_spinning_box"/>
                            <label for="line_report_upper_calender" string="Calandras superior / inferior"/>
                            <div class="o_row">
                                <field name="line_report_upper_calender" nolabel="1" placeholder="Superior"/>
                                <span class="mx-2">/</span>
                                <field name="line_report_lower_calender" nolabel="1" placeholder="Inferior"/>
                            </div>
                            <label for="line_report_additive" string="Aditivo / código"/>
                            <div class="o_row">
                                <field name="line_report_additive" nolabel="1" placeholder="Aditivo"/>
                                <span class="mx-2">/</span>
                                <field name="line_report_additive_code" nolabel="1" placeholder="Código"/>
                            </div>
                        </group>
                        <group>
                            <field name="line_report_pump_rpm"/>
                            <field name="line_report_cooling"/>
                            <field name="line_report_belt_speed"/>
                            <field name="line_report_k_constant" readonly="1"/>
                            <field name="line_report_temperatures"/>
                            <field name="line_report_calender_pressure"/>
                            <field name="line_report_additive_percentage"/>
                        </group>
                    </group>
                </page>
                <page string="Historial de turnos" name="line_report_shift_history">
                    <field name="fecha_inicio_turno" invisible="1"/>
                    <field name="line_report_active_shift_state" invisible="1"/>
                    <div class="alert alert-secondary" role="alert" invisible="fecha_inicio_turno or line_report_active_shift_id">
                        Todavía no existe un turno activo. El historial se creará al utilizar <strong>Iniciar Turno</strong>.
                    </div>
                    <div class="debytex-active-shift-panel" invisible="not fecha_inicio_turno and not line_report_active_shift_id">
                        <div>
                            <span class="debytex-shift-panel-label">Turno actual</span>
                            <field name="line_report_active_shift_id" nolabel="1" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                        </div>
                        <div>
                            <span class="debytex-shift-panel-label">Inicio</span>
                            <field name="line_report_active_shift_started_at" nolabel="1" readonly="1"/>
                        </div>
                        <div>
                            <span class="debytex-shift-panel-label">Estado</span>
                            <field name="line_report_active_shift_state"
                                   nolabel="1"
                                   readonly="1"
                                   widget="badge"
                                   decoration-success="line_report_active_shift_state == 'running'"
                                   decoration-warning="line_report_active_shift_state == 'paused'"
                                   decoration-muted="line_report_active_shift_state == 'closed'"/>
                        </div>
                        <div class="debytex-active-shift-timer-cell">
                            <span class="debytex-shift-panel-label">Tiempo efectivo</span>
                            <field name="line_report_active_shift_elapsed_seconds"
                                   nolabel="1"
                                   readonly="1"
                                   widget="debytex_shift_timer"/>
                        </div>
                    </div>

                    <div class="alert alert-info" role="alert" invisible="not line_report_shift_history_ids">
                        Cada fila conserva el centro de trabajo, su orden de trabajo, el cronómetro y una copia de los parámetros registrados al iniciar ese turno.
                        Cuando se seleccionan varias líneas, todas comparten el número de turno y aparecen como filas separadas.
                        Abra un registro para consultar la captura completa; los cambios posteriores en la orden no modifican este historial.
                    </div>
                    <separator string="Turnos y parámetros registrados"/>
                    <field name="line_report_shift_history_ids" nolabel="1" readonly="1">
                        <list string="Historial de turnos y parámetros" create="0" edit="0" delete="0">
                            <field name="turn_number"/>
                            <field name="name"/>
                            <field name="workcenter_id"/>
                            <field name="started_at"/>
                            <field name="closed_at"/>
                            <field name="state"
                                   widget="badge"
                                   decoration-success="state == 'running'"
                                   decoration-warning="state == 'paused'"
                                   decoration-muted="state == 'closed'"/>
                            <field name="elapsed_display"/>
                            <field name="pause_display" optional="show"/>
                            <field name="target_grammage" optional="show"/>
                            <field name="pump_rpm" optional="show"/>
                            <field name="belt_speed" optional="show"/>
                            <field name="winder_speed" optional="show"/>
                            <field name="k_constant" optional="show"/>
                            <field name="suction" optional="hide"/>
                            <field name="cooling" optional="hide"/>
                            <field name="range_hood" optional="hide"/>
                            <field name="spinning_box" optional="hide"/>
                            <field name="temperatures" optional="hide"/>
                            <field name="upper_calender" optional="hide"/>
                            <field name="lower_calender" optional="hide"/>
                            <field name="calender_pressure" optional="hide"/>
                            <field name="additive" optional="hide"/>
                            <field name="additive_code" optional="hide"/>
                            <field name="additive_percentage" optional="hide"/>
                            <field name="started_by_id" optional="hide"/>
                            <field name="closed_by_id" optional="hide"/>
                        </list>
                        <form string="Detalle del turno" create="0" edit="0" delete="0">
                            <sheet>
                                <div class="oe_title">
                                    <label for="name"/>
                                    <h1><field name="name" readonly="1"/></h1>
                                </div>
                                <group>
                                    <group>
                                        <field name="production_id" readonly="1"/>
                                        <field name="workcenter_id" readonly="1"/>
                                        <field name="workorder_id" readonly="1"/>
                                        <field name="turn_closure_id" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="state" widget="badge" readonly="1"/>
                                        <field name="started_at" readonly="1"/>
                                        <field name="closed_at" readonly="1"/>
                                        <field name="elapsed_display" readonly="1"/>
                                        <field name="pause_display" readonly="1"/>
                                    </group>
                                </group>
                                <notebook>
                                    <page string="Parámetros capturados al iniciar">
                                        <div class="alert alert-info" role="alert">
                                            Esta es la fotografía de los parámetros ingresados al iniciar el turno y no cambia cuando se editan los valores actuales de la orden.
                                        </div>
                                        <group>
                                            <group>
                                                <field name="target_grammage" readonly="1"/>
                                                <field name="suction" readonly="1"/>
                                                <field name="range_hood" readonly="1"/>
                                                <field name="winder_speed" readonly="1"/>
                                                <field name="spinning_box" readonly="1"/>
                                                <field name="upper_calender" readonly="1"/>
                                                <field name="lower_calender" readonly="1"/>
                                                <field name="additive" readonly="1"/>
                                                <field name="additive_code" readonly="1"/>
                                            </group>
                                            <group>
                                                <field name="pump_rpm" readonly="1"/>
                                                <field name="cooling" readonly="1"/>
                                                <field name="belt_speed" readonly="1"/>
                                                <field name="k_constant" readonly="1"/>
                                                <field name="temperatures" readonly="1"/>
                                                <field name="calender_pressure" readonly="1"/>
                                                <field name="additive_percentage" readonly="1"/>
                                            </group>
                                        </group>
                                    </page>
                                    <page string="Pausas">
                                        <field name="pause_ids" nolabel="1" readonly="1">
                                            <list create="0" edit="0" delete="0">
                                                <field name="started_at"/>
                                                <field name="ended_at"/>
                                                <field name="duration_display"/>
                                                <field name="reason_label"/>
                                                <field name="description" optional="show"/>
                                                <field name="paused_by_id" optional="hide"/>
                                                <field name="resumed_by_id" optional="hide"/>
                                            </list>
                                        </field>
                                    </page>
                                </notebook>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

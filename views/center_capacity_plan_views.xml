<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_center_capacity_plan_search" model="ir.ui.view">
        <field name="name">debytex.mrp.center.capacity.plan.search</field>
        <field name="model">debytex.mrp.center.capacity.plan</field>
        <field name="arch" type="xml">
            <search string="Buscar propuestas de capacidad">
                <field name="name"/>
                <field name="workcenter_id"/>
                <field name="responsible_id"/>
                <field name="planned_date"/>
                <separator/>
                <filter name="group_workcenter" string="Centro de trabajo" context="{'group_by': 'workcenter_id'}"/>
                <filter name="group_date" string="Fecha" context="{'group_by': 'planned_date'}"/>
                <filter name="group_company" string="Compañía" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="view_mrp_center_capacity_plan_list" model="ir.ui.view">
        <field name="name">debytex.mrp.center.capacity.plan.list</field>
        <field name="model">debytex.mrp.center.capacity.plan</field>
        <field name="arch" type="xml">
            <list string="Capacidad por centro" default_order="planned_date desc, id desc"
                  decoration-danger="over_capacity">
                <field name="name"/>
                <field name="planned_date"/>
                <field name="workcenter_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'started'"
                       decoration-muted="state == 'closed'"/>
                <field name="useful_width_cm"/>
                <field name="occupied_width_cm"/>
                <field name="free_width_cm"/>
                <field name="utilization_percentage"/>
                <field name="capacity_state" widget="badge"
                       decoration-muted="capacity_state == 'empty'"
                       decoration-success="capacity_state == 'available'"
                       decoration-info="capacity_state == 'full'"
                       decoration-danger="capacity_state == 'over'"/>
                <field name="responsible_id" optional="hide"/>
                <field name="started_at" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="over_capacity" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_mrp_center_capacity_plan_form" model="ir.ui.view">
        <field name="name">debytex.mrp.center.capacity.plan.form</field>
        <field name="model">debytex.mrp.center.capacity.plan</field>
        <field name="arch" type="xml">
            <form string="Propuesta de capacidad por centro">
                <header>
                    <button name="action_start_shifts"
                            string="Iniciar turno"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_open_material_consumption"
                            string="Consumir materiales"
                            type="object"
                            class="btn-warning"
                            invisible="state != 'started'"/>
                    <button name="action_finish_shifts"
                            string="Finalizar turno"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'started'"
                            confirm="Se finalizará el turno de todas las órdenes incluidas. ¿Desea continuar?"/>
                    <button name="action_send_all_to_stock"
                            string="Enviar todas a Almacén"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'closed'"
                            confirm="Se enviarán a almacén todas las órdenes pendientes de esta propuesta. ¿Desea continuar?"/>
                    <button name="action_final_production_report_all"
                            string="Reporte Final General"
                            type="object"
                            invisible="state != 'closed'"/>
                    <button name="action_export_rolls_excel_all"
                            string="Lista de Rollos Excel"
                            type="object"
                            invisible="state != 'closed'"/>
                    <button name="action_print_manufacturing_orders_all"
                            string="Imprimir Órdenes"
                            type="object"
                            invisible="not line_ids"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,started,closed"/>
                </header>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>

                    <div class="alert alert-info" role="alert" invisible="state != 'draft'">
                        <strong>Propuesta de fabricación conjunta.</strong>
                        Seleccione Peso, Color y Metros por rollo y complete la
                        cantidad de cada orden compatible. Al presionar Iniciar turno
                        se solicitarán los parámetros de operación de cada producto.
                    </div>
                    <div class="alert alert-success" role="alert" invisible="state != 'started'">
                        Los turnos fueron iniciados correctamente el
                        <field name="started_at" class="oe_inline" readonly="1"/>
                        por <field name="started_by_id" class="oe_inline" readonly="1"/>.
                        Use cada fila para registrar rollos. El consumo se captura una
                        sola vez desde el botón general Consumir materiales.
                    </div>
                    <div class="alert alert-secondary" role="alert" invisible="state != 'closed'">
                        Los turnos fueron finalizados el
                        <field name="closed_at" class="oe_inline" readonly="1"/>
                        por <field name="closed_by_id" class="oe_inline" readonly="1"/>.
                        Ya no se pueden registrar rollos ni materiales. Las etiquetas
                        existentes pueden reimprimirse con autorización y PIN de supervisor.
                    </div>

                    <group>
                        <group string="Centro y fecha">
                            <field name="workcenter_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="planned_date" readonly="state != 'draft'"/>
                        </group>
                        <group string="Responsable">
                            <field name="responsible_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="company_id"
                                   readonly="state != 'draft'"
                                   groups="base.group_multi_company"/>
                            <field name="capacity_state" widget="badge" readonly="1"
                                   decoration-muted="capacity_state == 'empty'"
                                   decoration-success="capacity_state == 'available'"
                                   decoration-info="capacity_state == 'full'"
                                   decoration-danger="capacity_state == 'over'"/>
                        </group>
                    </group>

                    <separator string="Atributos comunes obligatorios"/>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'draft' or filters_complete">
                        Seleccione un valor para los tres atributos. Hasta entonces no
                        habrá órdenes disponibles para agregar.
                    </div>
                    <field name="filters_complete" invisible="1"/>
                    <field name="allowed_production_ids" invisible="1"/>
                    <field name="attribute_filter_ids"
                           nolabel="1"
                           readonly="state != 'draft'">
                        <list editable="bottom" create="0" delete="0">
                            <field name="attribute_key" column_invisible="True"
                                   force_save="1"/>
                            <field name="attribute_id" readonly="1"
                                   force_save="1"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="value_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </list>
                    </field>

                    <div class="alert alert-warning" role="alert" invisible="not workcenter_id or useful_width_cm &gt; 0">
                        El centro seleccionado no tiene ancho configurado. Revise el ancho
                        del eje en la configuración del centro de trabajo.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not over_capacity">
                        La combinación excede el ancho útil por
                        <field name="excess_width_cm" class="oe_inline" readonly="1"/> cm.
                        Ajuste el número de bandas o quite una orden antes de utilizar esta propuesta.
                    </div>

                    <group string="Resumen de capacidad" col="6">
                        <field name="total_width_cm" readonly="1"/>
                        <field name="fixed_trim_width_cm" readonly="1"/>
                        <field name="useful_width_cm" readonly="1"/>
                        <field name="occupied_width_cm" readonly="1"/>
                        <field name="free_width_cm" readonly="1"/>
                        <field name="utilization_percentage" widget="progressbar" readonly="1"/>
                    </group>

                    <separator string="Distribución visual del eje"/>
                    <field name="capacity_preview_html" widget="html" nolabel="1" readonly="1"/>

                    <separator string="Órdenes propuestas"/>
                    <field name="line_ids"
                           nolabel="1"
                           readonly="state != 'draft'">
                        <list editable="bottom" open_form_view="1"
                              decoration-danger="not fits_alone or not attributes_match">
                            <field name="sequence" widget="handle"/>
                            <field name="company_id" column_invisible="True"/>
                            <field name="allowed_production_ids" column_invisible="True"/>
                            <field name="can_operate_shift" column_invisible="True"/>
                            <field name="can_relabel_roll" column_invisible="True"/>
                            <field name="production_id" options="{'no_create': True}"/>
                            <field name="product_id" readonly="1"/>
                            <field name="attributes_match" readonly="1" optional="hide"/>
                            <field name="product_uom_id" readonly="1" optional="hide"/>
                            <field name="width_cm"/>
                            <field name="lanes"/>
                            <field name="occupied_width_cm" readonly="1" sum="Total ocupado"/>
                            <field name="remaining_rolls" readonly="1" optional="show"/>
                            <field name="quantity_to_process" optional="show"/>
                            <field name="allocation_percentage" optional="show"/>
                            <field name="allocated_rolls" readonly="1" optional="show"/>
                            <field name="maximum_lanes" readonly="1" optional="hide"/>
                            <field name="fits_alone" widget="boolean_toggle" readonly="1" optional="hide"/>
                            <field name="execution_production_id" readonly="1" optional="hide"/>
                            <field name="remainder_production_id" readonly="1" optional="hide"/>
                            <field name="shift_history_id" readonly="1" optional="hide"/>
                            <button name="action_register_roll" type="object"
                                    string="Registrar rollo" class="btn-primary"
                                    invisible="not can_operate_shift"/>
                            <button name="action_relabel_roll" type="object"
                                    string="Reetiquetar rollo"
                                    invisible="not can_relabel_roll"/>
                        </list>
                        <form string="Orden incluida en la propuesta">
                            <header>
                                <button name="action_register_roll" type="object"
                                        string="Registrar rollo" class="btn-primary"
                                        invisible="not can_operate_shift"/>
                                <button name="action_relabel_roll" type="object"
                                        string="Reetiquetar rollo" class="btn-primary"
                                        invisible="not can_relabel_roll"/>
                            </header>
                            <sheet>
                                <field name="company_id" invisible="1"/>
                                <field name="plan_state" invisible="1"/>
                                <field name="allowed_production_ids" invisible="1"/>
                                <field name="can_operate_shift" invisible="1"/>
                                <field name="can_relabel_roll" invisible="1"/>
                                <div class="oe_title">
                                    <label for="production_id"/>
                                    <h1>
                                        <field name="production_id"
                                               readonly="plan_state != 'draft'"
                                               options="{'no_create': True}"/>
                                    </h1>
                                </div>
                                <div class="alert alert-info" role="alert"
                                     invisible="plan_state != 'draft'">
                                    Indique la cantidad exacta que se procesará. Si es
                                    menor que la cantidad disponible, al iniciar se creará
                                    otra orden de fabricación con el remanente.
                                </div>
                                <notebook>
                                    <page string="Cantidad y ancho" name="capacity_quantity">
                                        <group>
                                            <group string="Cantidad a fabricar">
                                                <field name="plan_id" readonly="1"/>
                                                <field name="product_id" readonly="1"/>
                                                <field name="product_uom_id" readonly="1"/>
                                                <field name="remaining_rolls" readonly="1"/>
                                                <field name="quantity_to_process"
                                                       readonly="plan_state != 'draft'"/>
                                                <field name="allocation_percentage"
                                                       readonly="plan_state != 'draft'"/>
                                                <field name="allocated_rolls" readonly="1"/>
                                            </group>
                                            <group string="Uso del ancho">
                                                <field name="workcenter_id" readonly="1"/>
                                                <field name="width_cm"
                                                       readonly="plan_state != 'draft'"/>
                                                <field name="lanes"
                                                       readonly="plan_state != 'draft'"/>
                                                <field name="occupied_width_cm" readonly="1"/>
                                                <field name="maximum_lanes" readonly="1"/>
                                                <field name="fits_alone" readonly="1"/>
                                            </group>
                                        </group>
                                    </page>
                                    <page string="Resultado" name="capacity_execution"
                                          invisible="plan_state == 'draft'">
                                        <group>
                                            <field name="source_quantity_at_start" readonly="1"/>
                                            <field name="execution_production_id" readonly="1"/>
                                            <field name="remainder_production_id" readonly="1"/>
                                            <field name="shift_history_id" readonly="1"/>
                                        </group>
                                    </page>
                                </notebook>
                            </sheet>
                        </form>
                    </field>

                    <group string="Observaciones">
                        <field name="notes" nolabel="1"
                               placeholder="Anote las condiciones o decisiones que el cliente debe revisar..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mrp_center_capacity_plan" model="ir.actions.act_window">
        <field name="name">Capacidad por centro</field>
        <field name="res_model">debytex.mrp.center.capacity.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mrp_center_capacity_plan_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Pruebe cuánto producto cabe por ancho.</p>
            <p>
                Seleccione un centro de trabajo y agregue órdenes de fabricación
                para comparar el ancho ocupado con el ancho útil disponible.
            </p>
        </field>
    </record>

    <menuitem id="menu_mrp_center_capacity_plan"
              name="Capacidad por centro"
              parent="mrp.mrp_planning_menu_root"
              action="action_mrp_center_capacity_plan"
              sequence="95"
              groups="mrp.group_mrp_user"/>
</odoo>

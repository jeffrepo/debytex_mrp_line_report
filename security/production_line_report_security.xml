<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_mrp_line_report_company" model="ir.rule">
        <field name="name">Reportes por línea de la compañía</field>
        <field name="model_id" ref="model_debytex_mrp_line_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>


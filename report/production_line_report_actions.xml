<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_production_line_report" model="report.paperformat">
        <field name="name">Debytex - Producción por línea</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <!-- El reporte usa un encabezado propio dentro de cada página. -->
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_production_line" model="ir.actions.report">
        <field name="name">Reporte de Producción por Línea</field>
        <field name="model">debytex.mrp.line.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">debytex_mrp_line_report.report_production_line_document</field>
        <field name="report_file">debytex_mrp_line_report.report_production_line_document</field>
        <field name="paperformat_id" ref="paperformat_production_line_report"/>
        <field name="binding_model_id" ref="model_debytex_mrp_line_report"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Debytex - Reporte por Línea - %s' % (object.name)</field>
    </record>
</odoo>

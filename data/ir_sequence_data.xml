<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="sequence_mrp_line_report" model="ir.sequence">
        <field name="name">Reporte de Producción por Línea</field>
        <field name="code">debytex.mrp.line.report</field>
        <field name="prefix">RPL/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="sequence_mrp_center_capacity_plan" model="ir.sequence">
        <field name="name">Propuesta de Capacidad por Centro</field>
        <field name="code">debytex.mrp.center.capacity.plan</field>
        <field name="prefix">CAP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>

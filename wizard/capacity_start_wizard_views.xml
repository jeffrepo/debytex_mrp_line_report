<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_center_capacity_start_wizard_form" model="ir.ui.view">
        <field name="name">debytex.mrp.center.capacity.start.wizard.form</field>
        <field name="model">debytex.mrp.center.capacity.start.wizard</field>
        <field name="arch" type="xml">
            <form string="Iniciar turno de fabricación">
                <sheet>
                    <div class="oe_title">
                        <h1>Parámetros de operación</h1>
                    </div>
                    <group>
                        <group>
                            <field name="plan_id" readonly="1"/>
                            <field name="workcenter_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="production_count" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Capture los parámetros una sola vez. Al confirmar, los mismos
                        valores se guardarán en todas las órdenes asociadas y en sus
                        historiales de turno. Los materiales no se consumirán en este paso.
                    </div>
                    <separator string="Parámetros de operación registrados"/>
                    <group>
                        <group>
                            <field name="line_report_target_grammage"/>
                            <field name="line_report_suction"/>
                            <field name="line_report_range_hood"/>
                            <field name="line_report_winder_speed"/>
                            <field name="line_report_spinning_box"/>
                            <label for="line_report_upper_calender"
                                   string="Calandras superior / inferior"/>
                            <div class="o_row">
                                <field name="line_report_upper_calender"
                                       nolabel="1" placeholder="Superior"/>
                                <span class="mx-2">/</span>
                                <field name="line_report_lower_calender"
                                       nolabel="1" placeholder="Inferior"/>
                            </div>
                            <label for="line_report_additive"
                                   string="Aditivo / código"/>
                            <div class="o_row">
                                <field name="line_report_additive"
                                       nolabel="1" placeholder="Aditivo"/>
                                <span class="mx-2">/</span>
                                <field name="line_report_additive_code"
                                       nolabel="1" placeholder="Código"/>
                            </div>
                        </group>
                        <group>
                            <field name="line_report_pump_rpm"/>
                            <field name="line_report_cooling"/>
                            <field name="line_report_belt_speed"/>
                            <field name="line_report_k_constant" readonly="1"/>
                            <field name="line_report_temperatures"/>
                            <field name="line_report_calender_pressure"/>
                            <field name="line_report_additive_percentage"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_and_start"
                            string="Guardar e Iniciar Turno"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
